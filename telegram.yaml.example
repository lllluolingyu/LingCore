# Copy this file to <profile>/telegram.yaml, then put the named values in that
# profile's .env (or inject them through the process environment).
token_env: TELEGRAM_BOT_TOKEN
allowed_user_ids:
  - 123456789

mode: polling
state_dir: .lingcore/telegram
allow_absolute_state_dir: false
stream_edit_interval: 0.75
confirmation_timeout: 60

webhook:
  public_url: https://example.com/hooks/lingcore
  listen: 127.0.0.1
  port: 8080
  secret_token_env: TELEGRAM_WEBHOOK_SECRET

