# Copy to profiles/daily/.env and fill the secret. The copied .env is
# gitignored and overrides same-named variables exported by the shell.

DEEPSEEK_API_KEY=

# Feishu / Lark channel credentials (used by lark.yaml).
LARK_APP_ID=
LARK_APP_SECRET=

# Web search uses DeepSeek and reuses DEEPSEEK_API_KEY above.
LINGCORE_SEARCH_PROVIDER=deepseek

# Optional search providers (no automatic fallback between providers):
# LINGCORE_SEARCH_PROVIDER=searxng
# Use your own or a trusted instance with search.formats including json.
SEARXNG_URL=
# LINGCORE_SEARCH_PROVIDER=exa
EXA_API_KEY=

# Optional profile overrides:
# LINGCORE_TIMEZONE=Asia/Shanghai   # clock + calendar; blank uses the host's zone
# LINGCORE_MODEL=deepseek-flash
# LINGCORE_BASE_URL=https://your-provider.example/v1
# LINGCORE_API_KEY_ENV=OPENAI_API_KEY
# OPENAI_API_KEY=
# LINGCORE_WORKSPACE=/absolute/path/to/workspace
